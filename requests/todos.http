### Create a new Todo

POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "Study REST API",
    "description": "Learn Node.js and Express",
    "state": "todo"
}

### Create a Todo with doing state
POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "Learn REST API",
    "description": "Practice Node.js and Express",
    "state": "doing"
}

### Create a Todo with done state
POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "Learn HTML",
    "description": "Complete HTML basics",
    "state": "done"
}
### Get all todos

GET http://localhost:3000/todos

### Get a single todo by ID

GET http://localhost:3000/todos/fca2a927-3675-46c1-a48c-ab3373aed2dc

### Update a todo

PATCH http://localhost:3000/todos/50844fbc-5971-49d8-aaa7-90813dd82419
Content-Type: application/json

{
    "state": "doing"
}

### Delete a todo

DELETE http://localhost:3000/todos/d97cfa86-4b53-4c77-b1b0-1516fcf961f6

### Test missing title

POST http://localhost:3000/todos
Content-Type: application/json

{
    "description": "Learn REST API"
}

### Test invalid state

POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "Study REST API",
    "state": "finished"
}

### Test PATCH invalid state

PATCH http://localhost:3000/todos/9f69f224-26be-4706-ba4f-f53594cf5347
Content-Type: application/json

{
    "state": "finished"
}

### Get all todos
GET http://localhost:3000/todos

### Get todos with todo state
GET http://localhost:3000/todos?state=todo

### Get todos with doing state
GET http://localhost:3000/todos?state=doing

### Get todos with done state
GET http://localhost:3000/todos?state=done

### Test invalid state
GET http://localhost:3000/todos?state=finished

### Test valid PATCH - update title

PATCH http://localhost:3000/todos/7f998a3a-0d6a-49d1-bf55-8a0cf6f69299
Content-Type: application/json

{
    "title": "Learning REST API with Node.js"
}

### Test PATCH with empty title

PATCH http://localhost:3000/todos/7f998a3a-0d6a-49d1-bf55-8a0cf6f69299
Content-Type: application/json

{
    "title": ""
}

### Test PATCH with invalid state

PATCH http://localhost:3000/todos/7f998a3a-0d6a-49d1-bf55-8a0cf6f69299
Content-Type: application/json

{
    "state": "finished"
}

### Test PATCH with non-existing ID

PATCH http://localhost:3000/todos/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
    "title": "Updated Todo"
}

### Test DELETE - delete an existing todo

DELETE http://localhost:3000/todos/8552fa80-f3ee-4ff3-9681-67e2a1f771d2

### Verify deleted todo

GET http://localhost:3000/todos/8552fa80-f3ee-4ff3-9681-67e2a1f771d2

### Test DELETE with non-existing ID

DELETE http://localhost:3000/todos/00000000-0000-0000-0000-000000000000

### Test malformed JSON

POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "Test malformed JSON",
    "state": "todo",
}